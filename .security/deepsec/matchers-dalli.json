[
  {
    "version": 1,
    "slug": "dalli-meta-wire-command-formatting",
    "description": "Meta protocol command lines built by string interpolation (keys, caller meta_flags, arithmetic values, stats args, pipelined fast paths) where CR/LF or extra tokens can desynchronize the wire stream.",
    "noiseTier": "precise",
    "filePatterns": [
      "lib/dalli/protocol/meta/request_formatter.rb",
      "lib/dalli/protocol/meta.rb"
    ],
    "patterns": [
      {
        "source": "cmd = \"m[gsad] #\\{key\\}",
        "flags": "m",
        "label": "key interpolated into meta command"
      },
      {
        "source": "cmd << \" #\\{meta_flags\\.join\\(' '\\)\\}\"",
        "flags": "m",
        "label": "caller meta_flags joined into command"
      },
      {
        "source": "cmd << \" [DJ]#\\{(?:delta|initial)\\}\"",
        "flags": "m",
        "label": "arithmetic delta/initial interpolated into command"
      },
      {
        "source": "cmd << \" #\\{arg\\}\" if arg",
        "flags": "m",
        "label": "stats argument interpolated"
      },
      {
        "source": "\"m[gs] #\\{encoded_key\\}",
        "flags": "m",
        "label": "pipelined/fast-path command with regularized key written directly"
      }
    ],
    "examples": [
      "          cmd = \"mg #{key}\"",
      "          cmd = \"md #{key}\"",
      "          cmd = \"ma #{key} v\"",
      "          cmd << \" #{meta_flags.join(' ')}\" if meta_flags && !meta_flags.empty?",
      "          cmd << \" D#{delta}\" if delta",
      "          cmd << \" J#{initial}\" if initial",
      "          cmd << \" #{arg}\" if arg",
      "              \"ms #{encoded_key} #{value_bytesize} c F#{bitflags} T#{ttl} MS q#{routing_suffix}\\r\\n\"",
      "        @connection_manager.write(\"mg #{encoded_key}#{' b' if base64} #{post_get_req}\")",
      "            write(opaque ? \"mg #{encoded_key} v O#{opaque}\\r\\n\" : \"mg #{encoded_key} v\\r\\n\")"
    ],
    "closesSurfaceIds": ["meta-wire-command-interpolation"]
  },
